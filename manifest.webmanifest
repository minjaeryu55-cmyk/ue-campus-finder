{
  "name": "UE Campus Finder",
  "short_name": "UE Finder",
  "description": "Lost something at UE? Check every campus storage place in one search.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f6f5f0",
  "theme_color": "#2f5d62",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "I lost something", "url": "./#lost", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "I found something", "url": "./#found", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
}
